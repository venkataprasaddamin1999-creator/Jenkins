pipeline {
    agent {
        label 'ROBOSHOP'
    }


    stages {
        stage('Build') {
            steps {
                sh 'echo build'
            }
        }
        stage('Test') {
            steps {
                sh 'echo test'
            }
        }
        stage('Deploy') {
            steps {
                sh 'echo deploy'
            }
        }
        
    }

    post {
        always {
            echo 'Pipeline finished (runs every time)'
            cleanWs()
        }
        success {
            echo 'Build succeeded'
        }
        failure {
            echo 'Build failed'
        }
        unstable {
            echo 'Build is unstable'
        }
        changed {
            echo 'Build status changed from the previous run'
        }
    }
}